{
  "name": "airtunes2",
  "description": "an AirTunes v2 implementation: stream wirelessly to audio devices.",
  "keywords": [
    "airtunes",
    "airplay",
    "raop",
    "coreaudio",
    "sound",
    "audio",
    "cider"
  ],
  "version": "2.4.9-babelpod.5",
  "author": "vapormusic <vapormusic.service@gmail.com>",
  "main": "./lib/index.js",
  "files": [
    "binding.gyp",
    "lib",
    "prebuilds/*/airtunes.node",
    "scripts/use-prebuilt.js",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ciderapp/node_airtunes2.git"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "install": "node scripts/use-prebuilt.js || npm run rebuild || exit 0",
    "rebuild": "node-gyp configure build",
    "pack-release": "scripts/pack-release.sh",
    "vaportest": "node examples\\play_radio.js --host 192.168.100.12 --port 7000  --debug true --mode 1 --airplay2 1"
  },
  "licenses": [
    {
      "type": "AGPLv3"
    }
  ],
  "dependencies": {
    "@noble/ed25519": "^1.6.1",
    "async": "^3.2.1",
    "axlsign": "^1.0.0",
    "big-integer": "^1.6.25",
    "bplist-creator": "0.1.0",
    "bplist-parser": "0.3.1",
    "curve25519-js": "^0.0.4",
    "elliptic": "^6.4.0",
    "js-sha1": "^0.4.1",
    "lodash": "^4.17.4",
    "python-struct": "^1.1.3",
    "varint": "^6.0.0"
  },
  "bugs": {
    "url": "https://github.com/ciderapp/node_airtunes2/issues"
  }
}
